{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type",
    "status"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "ate",
        "cate",
        "graph",
        "sem",
        "experimental_reference_estimate",
        "none"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "manual",
        "external",
        "not_applicable"
      ]
    },
    "estimand": {
      "type": [
        "string",
        "null"
      ]
    },
    "treatment": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "standard_error": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence_interval_95": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "version",
    "source",
    "license",
    "schema",
    "files",
    "graph",
    "ground_truth",
    "intended_tasks",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "synthetic_sem",
        "synthetic_bayesian_network",
        "real_experimental_reference"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "homepage",
        "download_urls",
        "papers"
      ],
      "properties": {
        "homepage": {
          "type": "string"
        },
        "download_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "papers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unknown",
            "restricted"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "schema": {
      "type": "object",
      "required": [
        "treatment",
        "outcome",
        "covariates",
        "effect_modifiers"
      ],
      "properties": {
        "treatment": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "covariates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effect_modifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "required": [
        "raw",
        "processed"
      ],
      "properties": {
        "raw": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "status",
              "description"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "available",
                  "manual",
                  "external",
                  "not_applicable"
                ]
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "processed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "status",
              "description"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "available",
                  "manual",
                  "external",
                  "not_applicable"
                ]
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": [
        "available",
        "format",
        "path",
        "status"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "enum": [
            "dot",
            "json",
            "bif",
            "adjacency",
            "none"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "available",
            "manual",
            "external",
            "not_applicable"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "ground_truth": {
      "type": "object",
      "required": [
        "type",
        "path",
        "status"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ate",
            "cate",
            "graph",
            "sem",
            "experimental_reference_estimate",
            "none"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "available",
            "manual",
            "external",
            "not_applicable"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "intended_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "ate_estimation",
          "cate_estimation",
          "causal_discovery",
          "sensitivity_analysis"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
